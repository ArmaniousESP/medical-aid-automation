# Google Service Account (share the spreadsheet with this email as Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The Google Sheet ID (from the URL)
GOOGLE_SHEET_ID=1abc...your_sheet_id

# Optional: protect process / generate / enroll / sync endpoints
PROCESS_SECRET=a-long-random-string

# Optional: external Egyptian medicine price sources
# DWAPRICES_API_URL=https://dwaprices.com/sample-api.php
# EGYPTIAN_DRUG_DB_URL=https://raw.githubusercontent.com/karem505/egyptian-drug-database/main/data/egyptian-drugs.json

# TPA / eTPA integration (chronic meds)
# TPA_WEBHOOK_SECRET=long-random-string
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Neon PostgreSQL (pooled connection string from console.neon.tech)
# DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# After process: auto-create/update chronic_programs from Approved-Requests (default on)
# AUTO_ENROLL_CHRONIC=true
