# Google Service Account (share the spreadsheet with this email as Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The Google Sheet ID (from the URL)
GOOGLE_SHEET_ID=1abc...your_sheet_id

# Optional: protect the /api/process endpoint
PROCESS_SECRET=a-long-random-string

# Optional: external Egyptian medicine price sources
# DwaPrices sample API (default works without key for limited use)
# DWAPRICES_API_URL=https://dwaprices.com/sample-api.php
# Open Egyptian Drug Database JSON (GitHub, CC0)
# EGYPTIAN_DRUG_DB_URL=https://raw.githubusercontent.com/karem505/egyptian-drug-database/main/data/egyptian-drugs.json
